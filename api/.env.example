# Copy to .env for local development. Never commit .env.

# Neon (or any PostgreSQL 15+) connection string. The pipeline needs a direct (unpooled)
# connection for COPY; the API can use the pooled host.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Long random string; signs session cookies.
JWT_SECRET=

# true behind HTTPS (production), false on http://localhost
COOKIE_SECURE=false
ENVIRONMENT=development

# Shared password for the three demo accounts, shown on the sign-in page when DEMO_MODE=1.
# The pipeline sets it when it creates the accounts.
DEMO_MODE=1
DEMO_PASSWORD=arunika-demo

# Optional: Gemini turns Ask questions into query specs. Empty = rules parser only.
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash
